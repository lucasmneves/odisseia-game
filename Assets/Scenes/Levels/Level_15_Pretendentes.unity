  - key: dlg.Level_15_Pretendentes.PenelopeDialogueController.0
    speaker: "Pen\xE9lope"
    text: "Vinte anos esperando, testando pretendente ap\xF3s pretendente com enigmas
      e adiamentos. Se voc\xEA \xE9 mesmo Odisseu... prove."
  secondsPerLine: 3
  panel: {fileID: 637758999}
  speakerText: {fileID: 126741238}
  bodyText: {fileID: 1275939939}
  inputActions: {fileID: -944628639613478452, guid: 29b9f4b741cb5074bb14fb2c8737772b, type: 3}
