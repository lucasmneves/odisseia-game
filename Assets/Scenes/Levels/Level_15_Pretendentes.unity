  data: {fileID: 0}
  lines:
  - key: dlg.Level_15_Pretendentes.IntroDialogueController.0
    speaker: Odisseu
    text: "O sal\xE3o do meu pr\xF3prio pal\xE1cio, tomado por homens que devoram
      meus bens e cortejam minha esposa \xE0 for\xE7a. Isso termina hoje."
  secondsPerLine: 3
