  data: {fileID: 0}
  lines:
  - key: dlg.Level_05_Ciclopes.IntroDialogueController.0
    speaker: Odisseu
    text: "A tempestade nos jogou numa costa que nenhum mapa conhece. Precisamos
      de \xE1gua e comida."
  - key: dlg.Level_05_Ciclopes.IntroDialogueController.1
    speaker: Odisseu
    text: "Esta caverna cheira a carneiro e a algo muito maior. \xC9 melhor eu n\xE3o
      ser visto."
  secondsPerLine: 3
