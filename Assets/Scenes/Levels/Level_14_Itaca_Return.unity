  m_Script: {fileID: 11500000, guid: 97bd157aa7ec8974f89cee9e3b0842f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Odisseia.UI.DialogueSequence
  data: {fileID: 0}
  lines:
  - key: dlg.Level_14_Itaca_Return.IntroDialogueController.0
    speaker: Odisseu
    text: "\xCDtaca. Depois de vinte anos, finalmente piso em solo natal \u2014 mas
      Atena me avisa: ainda n\xE3o \xE9 hora de ser reconhecido."
  - key: dlg.Level_14_Itaca_Return.IntroDialogueController.1
    speaker: Odisseu
    text: "Preciso descobrir o que aconteceu na minha aus\xEAncia antes que algu\xE9m
      descubra que eu voltei."
  secondsPerLine: 3
  panel: {fileID: 1550009879}
