  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Odisseia.UI.DialogueSequence
  data: {fileID: 0}
  lines:
  - key: dlg.Level_04_Citera.IntroDialogueController.0
    speaker: 
    text: "Depois de deixar os c\xEDcones, Odisseu e seus homens retomaram o caminho
      para casa. Mas o mar n\xE3o permitiria uma viagem tranquila."
  - key: dlg.Level_04_Citera.IntroDialogueController.1
    speaker: 
    text: "Uma terr\xEDvel tempestade surgiu no horizonte."
  - key: dlg.Level_04_Citera.IntroDialogueController.2
    speaker: Odisseu
    text: "Segurem-se! N\xE3o deixem o navio virar!"
  secondsPerLine: 3
  panel: {fileID: 845493886}
  speakerText: {fileID: 322591431}
  bodyText: {fileID: 336054309}
